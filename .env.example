# Example environment for local development. Copy to .env (gitignored) and
# adjust. Never put production credentials here; production secrets come from
# OpenBao (P0). See docs/reference/environment.md.
SAUTI_ENV=dev
SAUTI_CONFIG_DIR=config
SAUTI_DEVKEYS_DIR=.devkeys
SAUTI_DEV_DB_PASSWORD=change-me-dev-only
SAUTI_OP_DSN=postgres://op_intake:change-me-dev-only@127.0.0.1:5432/sauti_operational?sslmode=disable
SAUTI_AUDIT_DSN=postgres://audit_appender:change-me-dev-only@127.0.0.1:5432/sauti_audit?sslmode=disable
SAUTI_HTTP_ADDR=127.0.0.1:8080
SAUTI_ADMIN_ADDR=127.0.0.1:9100
SAUTI_AT_PATH_TOKEN=replace-with-at-least-24-random-characters
SAUTI_USSD_SERVICE_CODES=*384*1#
SAUTI_RULES_ROOT=.
# ivr-controller (role op_ivr for SAUTI_OP_DSN). ARI listens on loopback only.
SAUTI_ARI_URL=http://127.0.0.1:8088
SAUTI_ARI_USER=sauti
# SAUTI_ARI_PASSWORD=<from your local Asterisk ari.conf; OpenBao in production>
SAUTI_ARI_APP=sauti-ivr
# Outbound calls (placeholders until P0): the coordinator line, and the tier-2
# backup line rung as well after escalation.backup_after_calls unanswered rings.
# SAUTI_COORDINATOR_DIAL=PJSIP/sauti-coordinators-placeholder
# SAUTI_COORDINATOR_BACKUP_DIAL=PJSIP/sauti-coordinators-backup-placeholder
# Sauti's number for escalation calls and the bridge. The fallback dialplan's
# SAUTI_CALLER_ID global (extensions.conf, not this file) must be set to the
# same value in P0: it masks the caller ID on every call put through to a
# coordinator.
# SAUTI_ARI_CALLER_ID=<Sauti's public number, P0>
# sautictl escalations reads this op_readonly DSN when --dsn is not given.
# SAUTI_DSN=postgres://op_readonly:<password>@127.0.0.1:5432/sauti_operational
SAUTI_WITNESS_DIR=var/witness
SAUTI_ORIGIN=sauti-dispatch-dev
# Shared test server (optional; unset = private embedded PostgreSQL per test process).
# Both variables are required together: roles are shared by every test process.
# SAUTI_TEST_PG_DSN=postgres://postgres:<superuser-password>@127.0.0.1:5432/postgres?sslmode=disable
# SAUTI_TEST_ROLE_PASSWORD=<any shared value for this server>
