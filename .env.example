# Example environment for local development. Copy to .env (gitignored) and
# adjust. Never put production credentials here; production secrets come from
# OpenBao (P0). See docs/reference/environment.md.
SAUTI_ENV=dev
SAUTI_CONFIG_DIR=config
SAUTI_DEVKEYS_DIR=.devkeys
SAUTI_DEV_DB_PASSWORD=change-me-dev-only
SAUTI_OP_DSN=postgres://op_intake:change-me-dev-only@127.0.0.1:5432/sauti_operational?sslmode=disable
SAUTI_AUDIT_DSN=postgres://audit_appender:change-me-dev-only@127.0.0.1:5432/sauti_audit?sslmode=disable
SAUTI_HTTP_ADDR=127.0.0.1:8080
SAUTI_ADMIN_ADDR=127.0.0.1:9100
SAUTI_AT_PATH_TOKEN=replace-with-at-least-24-random-characters
SAUTI_USSD_SERVICE_CODES=*384*1#
SAUTI_DEFAULT_LANG=en
SAUTI_WITNESS_DIR=var/witness
SAUTI_ORIGIN=sauti-dispatch-dev
# Superuser URL of a disposable PostgreSQL 18 server for tests and the demo.
# SAUTI_TEST_PG_DSN=postgres://postgres:postgres@127.0.0.1:5432/postgres?sslmode=disable
